APP_NAME=Portfolio Backend
APP_ENV=development
APP_DEBUG=true

ADMIN_USERNAME=<SET_LOCALLY>
ADMIN_PASSWORD=<SET_LOCALLY>

CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
TRUSTED_HOSTS=localhost,127.0.0.1

SQLITE_DATABASE_PATH=./portfolio.db
SQLITE_REQUIRE_EXISTING=false
SQLITE_BUSY_TIMEOUT_MS=5000

LOG_LEVEL=INFO
ENABLE_API_DOCS=true
