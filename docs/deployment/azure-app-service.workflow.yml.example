name: Azure App Service backend (template)

on:
  workflow_dispatch:
  push:
    branches:
      - main
    paths:
      - "backend/**"
      - "docs/deployment/azure-app-service.workflow.yml.example"
      - "docs/deployment/azure-app-service.settings.env.example"

permissions:
  id-token: write
  contents: read

jobs:
  validate_and_deploy_backend:
    name: Validate and deploy backend
    runs-on: ubuntu-latest

    steps:
      - name: Checkout
        uses: actions/checkout@v4

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Install backend dependencies
        working-directory: backend
        run: python -m pip install -r requirements.txt

      - name: Run backend tests
        working-directory: backend
        env:
          APP_ENV: test
          ADMIN_USERNAME: qa_user
          ADMIN_PASSWORD: qa_password_for_workflow_only
          CORS_ALLOWED_ORIGINS: http://localhost:5173
          TRUSTED_HOSTS: testserver,localhost,127.0.0.1
          LOG_CONSOLE: "false"
        run: python -m pytest -q

      - name: Validate App Service package
        working-directory: backend
        run: python -m app.scripts.validate_azure_app_service

      - name: Azure login
        uses: azure/login@v2
        with:
          client-id: ${{ secrets.AZURE_CLIENT_ID }}
          tenant-id: ${{ secrets.AZURE_TENANT_ID }}
          subscription-id: ${{ secrets.AZURE_SUBSCRIPTION_ID }}

      - name: Deploy backend package
        uses: azure/webapps-deploy@v3
        with:
          app-name: ${{ vars.AZURE_WEBAPP_NAME }}
          package: backend
